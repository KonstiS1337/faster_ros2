<?xml version="1.0"?>
<package format="3">
  <name>decomp_ros_utils</name>
  <version>0.1.0</version>
  <description>The decomp_ros_utils package</description>
  <maintainer email="konstantin.stute@stud.tu-darmstadt.de">Konstantin Stute</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rviz2</depend>
  <depend>decomp_util</depend>
  <depend>eigen3_cmake_module</depend>
  <depend>decomp_ros_msgs</depend>
  <depend>rviz_common</depend>
  <depend>rviz_default_plugins</depend>
  <depend>pluginlib</depend>
  <depend>nav_msgs</depend>
  <depend>faster_msgs</depend>

